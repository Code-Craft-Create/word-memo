rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these Google accounts can see and edit the shared verses. Use lowercase addresses.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['first.person@gmail.com', 'second.person@gmail.com'];
    }
    match /verses/{verseId} {
      allow read, write: if allowed();
    }
    // Learning sets (named lists of verses) are shared like the verses.
    match /sets/{setId} {
      allow read, write: if allowed();
    }
    // Each person's learning progress is theirs alone.
    match /progress/{userId} {
      allow read, write: if allowed() && request.auth.uid == userId;
    }
  }
}
